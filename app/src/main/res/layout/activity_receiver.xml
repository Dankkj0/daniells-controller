<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp" android:background="#101216">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="daniell's controller" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/receiverStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV pronta para receber" android:textColor="#7CFF8A" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="MODO TV  •  receptor em segundo plano" android:textColor="#9AA0AA" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="22dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/receiverConnectionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CELULAR  •  desconectado" android:textColor="#9AA0AA" android:textSize="18sp" />
            <TextView android:id="@+id/receiverLastCommandText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Último comando: —" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/receiverStatsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Pronto • rede Wi-Fi local" android:textColor="#9AA0AA" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="BOTÕES" android:textColor="#9AA0AA" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/receiverButtonsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="□  ○  △  ×     L1  L2  R1  R2&#10;D-pad: —     Options  Share  PS" android:textColor="#FFFFFF" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="28dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANALÓGICOS" android:textColor="#9AA0AA" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/receiverSticksText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="L  X: 0.00  Y: 0.00&#10;R  X: 0.00  Y: 0.00&#10;L2: 0.00     R2: 0.00" android:textColor="#FFFFFF" android:textSize="17sp" />
            <TextView android:id="@+id/receiverSequenceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="SEQ: —" android:textColor="#9AA0AA" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/receiverStartButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="RECEBER CONTROLE" android:textSize="18sp" />
</LinearLayout>
