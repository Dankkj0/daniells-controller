<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp"
    android:background="#101114"
    android:focusable="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="daniell's controller"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="MODO TV"
        android:textColor="#8BC34A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/receiverStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="TV pronta para receber"
        android:textColor="#BDBDBD"
        android:textSize="18sp" />

    <Button
        android:id="@+id/receiverStartButton"
        android:layout_width="420dp"
        android:layout_height="76dp"
        android:layout_marginTop="30dp"
        android:focusable="true"
        android:text="RECEBER CONTROLE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/receiverStatsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Pronto • rede Wi-Fi local"
        android:textColor="#777A80"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="Abra o modo CELULAR no telefone para conectar um controle."
        android:textColor="#66686D"
        android:textSize="14sp" />
</LinearLayout>
