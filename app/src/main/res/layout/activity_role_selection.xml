<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#101114">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DANIELL'S CONTROLLER"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Como você vai usar o aplicativo?"
        android:textColor="#BDBDBD"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/roleTvButton"
            android:layout_width="240dp"
            android:layout_height="100dp"
            android:layout_marginEnd="16dp"
            android:text="📺  SOU TV"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/rolePhoneButton"
            android:layout_width="240dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:text="📱  SOU CELULAR"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Essa escolha será salva e usada nas próximas vezes."
        android:textColor="#777777"
        android:textSize="13sp" />
</LinearLayout>
