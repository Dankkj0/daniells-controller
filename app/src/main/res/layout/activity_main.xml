<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#101114">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="daniell's controller" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:gravity="center"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Procurando controle..." android:textSize="15sp"
            android:textColor="#BDBDBD" android:gravity="center"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="CONECTAR À TV AUTOMATICAMENTE"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Abra 'RECEBER CONTROLE' na TV. Ela aparecerá aqui automaticamente quando estiver na mesma rede Wi-Fi."
            android:textColor="#AAAAAA" android:textSize="12sp"/>
        <LinearLayout android:id="@+id/tvList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/udpStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Nenhuma TV selecionada" android:textColor="#8BC34A" android:textSize="12sp"/>
        <Button android:id="@+id/udpButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="ENVIAR CONTROLE"/>
        <Button android:id="@+id/hidTestButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="TESTAR GAMEPAD BLUETOOTH HID"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="DIAGNÓSTICO DO CONTROLE"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="horizontal">
            <com.daniell.controller.StickView android:id="@+id/leftStick" android:layout_width="0dp" android:layout_height="190dp"
                android:layout_weight="1" android:layout_marginEnd="6dp"/>
            <com.daniell.controller.StickView android:id="@+id/rightStick" android:layout_width="0dp" android:layout_height="190dp"
                android:layout_weight="1" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/leftStickText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="LX 0.000&#10;LY 0.000" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center"/>
            <TextView android:id="@+id/rightStickText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="RX 0.000&#10;RY 0.000" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center"/>
        </LinearLayout>
        <TextView android:id="@+id/triggersText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="L2 0.000    R2 0.000" android:textColor="#FFFFFF" android:textSize="15sp" android:gravity="center"/>
        <TextView android:id="@+id/buttonsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="BOTÕES PRESSIONADOS&#10;Nenhum" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/deviceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="DISPOSITIVO" android:textColor="#BDBDBD" android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/rawAxesText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="EIXOS" android:textColor="#BDBDBD" android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/eventText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Último evento: nenhum" android:textColor="#BDBDBD" android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="LOG DE EVENTOS" android:textColor="#8BC34A" android:textSize="10sp" android:fontFamily="monospace"/>
    </LinearLayout>
</ScrollView>
