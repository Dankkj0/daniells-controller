<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#101114">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="daniell's controller" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:gravity="center"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Procurando controle..." android:textSize="15sp"
            android:textColor="#BDBDBD" android:gravity="center"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="RELAY UDP — REDE LOCAL"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <EditText android:id="@+id/ipEdit" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="IP da TV" android:text="192.168.1.100"
                android:textColor="#FFFFFF" android:textColorHint="#777777"
                android:inputType="text" android:singleLine="true"/>
            <EditText android:id="@+id/portEdit" android:layout_width="90dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:hint="Porta" android:text="4242"
                android:textColor="#FFFFFF" android:textColorHint="#777777"
                android:inputType="number" android:singleLine="true"/>
        </LinearLayout>
        <Button android:id="@+id/udpButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="INICIAR TRANSMISSÃO"/>
        <TextView android:id="@+id/udpStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="UDP: parado" android:textColor="#8BC34A" android:textSize="12sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal">
            <com.daniell.controller.StickView android:id="@+id/leftStick"
                android:layout_width="0dp" android:layout_height="190dp"
                android:layout_weight="1" android:layout_marginEnd="6dp"/>
            <com.daniell.controller.StickView android:id="@+id/rightStick"
                android:layout_width="0dp" android:layout_height="190dp"
                android:layout_weight="1" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/leftStickText" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="LX 0.000
LY 0.000" android:textColor="#FFFFFF"
                android:textSize="13sp" android:gravity="center"/>
            <TextView android:id="@+id/rightStickText" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="RX 0.000
RY 0.000" android:textColor="#FFFFFF"
                android:textSize="13sp" android:gravity="center"/>
        </LinearLayout>
        <TextView android:id="@+id/triggersText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="L2 0.000    R2 0.000" android:textColor="#FFFFFF"
            android:textSize="15sp" android:gravity="center"/>
        <TextView android:id="@+id/buttonsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="BOTÕES PRESSIONADOS
Nenhum" android:textColor="#FFFFFF"
            android:textSize="14sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/deviceText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="DISPOSITIVO" android:textColor="#BDBDBD"
            android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/rawAxesText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="EIXOS" android:textColor="#BDBDBD"
            android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/eventText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Último evento: nenhum" android:textColor="#BDBDBD"
            android:textSize="11sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/logText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="LOG DE EVENTOS" android:textColor="#8BC34A"
            android:textSize="10sp" android:fontFamily="monospace"/>
    </LinearLayout>
</ScrollView>
